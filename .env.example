# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Any OpenAI-compatible provider works. Examples:
#   OpenAI:                    https://api.openai.com/v1
#   Vultr Serverless Inference: https://api.vultrinference.com/v1
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=

# Vultr API (read-only, cost gate). Server-side only, never log.
VULTR_API_KEY=

# Demo mode: 1 forces synthetic job data (?demo=1), 0 is live.
DEMO_MODE=0

# Single-worker job queue concurrency (do not raise on 2GB VM).
JOB_CONCURRENCY=1

# Pinned scanner version (secrets gate).
GITLEAKS_VERSION=8.18.4
